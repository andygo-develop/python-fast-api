# Deployment environment. "local" is the only value that permits a missing or
# placeholder AUTH_SECRET_KEY; anything else refuses to start without a real one.
ENVIRONMENT=local

# Signing key for access tokens. Generate with: openssl rand -hex 32
# Never commit the real value — this file documents the name, not the secret.
AUTH_SECRET_KEY=change-me

# JWT signing algorithm.
AUTH_ALGORITHM=HS256

# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# SQLAlchemy database URL. Defaults to a local SQLite file; point at Postgres
# (postgresql+psycopg://user:pass@host/db) without any code change.
DATABASE_URL=sqlite:///./app.db
